{
  "redirects": [
    { "source": "/qrcard", "destination": "/qrcard.html", "permanent": true },

    { "source": "/about",   "destination": "/about.html",   "permanent": true },
    { "source": "/contact", "destination": "/contact.html", "permanent": true },

    { "source": "/quelvo",   "destination": "/quelvo/",   "permanent": true },
    { "source": "/services", "destination": "/services/", "permanent": true },
    { "source": "/projects", "destination": "/projects/", "permanent": true },

    { "source": "/domotica",           "destination": "/services/", "permanent": true },
    { "source": "/domotica/:path*",    "destination": "/services/", "permanent": true },
    { "source": "/software",           "destination": "/services/", "permanent": true },
    { "source": "/software/:path*",    "destination": "/services/", "permanent": true },
    { "source": "/automatizaciones",        "destination": "/services/", "permanent": true },
    { "source": "/automatizaciones/:path*", "destination": "/services/", "permanent": true },

    { "source": "/blog", "destination": "/blog/", "permanent": true },

    { "source": "/chofer-privado",              "destination": "/quelvo/",            "permanent": true },
    { "source": "/chofer-privado/reservar.html","destination": "/quelvo/book/",       "permanent": false },
    { "source": "/chofer-privado/gracias.html", "destination": "/quelvo/book/gracias/", "permanent": true },

    { "source": "/nosotros.html",   "destination": "/about.html",   "permanent": true },
    { "source": "/contacto.html",   "destination": "/contact.html", "permanent": true },
    { "source": "/privacidad.html", "destination": "/privacy.html", "permanent": true },
    { "source": "/terminos.html",   "destination": "/terms.html",   "permanent": true },
    { "source": "/mi-cuenta.html",  "destination": "/account.html", "permanent": true },

    { "source": "/reset-password", "destination": "/reset-password.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), magnetometer=(), gyroscope=(), accelerometer=(), browsing-topics=()" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://esm.sh https://maps.googleapis.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://maps.gstatic.com https://maps.googleapis.com https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://nrmajnnfejafbtkpvpob.supabase.co wss://nrmajnnfejafbtkpvpob.supabase.co https://esm.sh https://formspree.io https://maps.googleapis.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; form-action 'self' https://formspree.io; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; manifest-src 'self'" }
      ]
    }
  ]
}
